<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                              http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Electricity Bill Calculator</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!--
        The servlet is also declared via the @WebServlet annotation in
        BillCalculatorServlet.java. This explicit mapping is kept here too
        so the project works even on containers/IDE setups that expect the
        classic web.xml-based configuration.
    -->
    <servlet>
        <servlet-name>BillCalculatorServlet</servlet-name>
        <servlet-class>electricitybill.BillCalculatorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillCalculatorServlet</servlet-name>
        <url-pattern>/CalculateBillServlet</url-pattern>
    </servlet-mapping>

    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

</web-app>